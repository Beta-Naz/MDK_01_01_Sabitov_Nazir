<UserControl x:Class="Airlines_Сабитов.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Airlines_Сабитов.Elements"
             mc:Ignorable="d">
    <Grid Background="LightGray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.7*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="0.7*"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <StackPanel>
                <Label x:Name="price" HorizontalContentAlignment="Center" Content="1999 P" FontSize="24" Margin="0,20,0,0"/>
                <Button HorizontalAlignment="Center" Height="30" 
                        Margin="0,10,0,0" Background="Red" Foreground="White"
                            Padding="40,0,40,0" FontSize="18" Content="Подробнее"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1">
            <StackPanel>
                <Label Content="pobeda" FontSize="14" Margin="0,20,0,0"/>
                <Label x:Name="startTime" Content="05:50" FontWeight="DemiBold" FontSize="20" Margin="0,15,0,0"/>
                <Label x:Name="city" Content="Триполи" FontSize="14" Margin="0,5,0,0"/>
                <Label x:Name="startDate" Content="11 сентября 2001" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Column="2">
            <Grid VerticalAlignment="Center" Margin="0,0,0,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Image VerticalAlignment="Top" Height="30" HorizontalAlignment="Left" Source="/Airlines_Сабитов;component/Images/airIcon.png"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Label x:Name="timer" HorizontalContentAlignment="Center" Content="В пути 2ч 15 мин"/>
                </Grid>
                <Grid Grid.Column="2">
                    <Image VerticalAlignment="Top" Height="30" HorizontalAlignment="Right" Source="/Airlines_Сабитов;component/Images/airIconDown.png"/>
                </Grid>
            </Grid>
            <Grid Background="Gray" VerticalAlignment="Center" Height="5"/>
        </Grid>
        <Grid Grid.Column="3">
            <StackPanel>
                <Label Content="pobeda" FontSize="14" Margin="0,20,0,0"/>
                <Label x:Name="endTime" Content="08:00" FontWeight="DemiBold" FontSize="20" Margin="0,15,0,0"/>
                <Label x:Name="endCity" Content="Вашингктон" FontSize="14" Margin="0,5,0,0"/>
                <Label x:Name="endDate" Content="11 сентября 2001" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
