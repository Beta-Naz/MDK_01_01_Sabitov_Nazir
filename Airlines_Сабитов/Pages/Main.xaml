<Page x:Class="Airlines_Сабитов.Pages.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Airlines_Сабитов.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Main">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>
        <Grid Background="Blue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid>
                <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                    <Image Width="40" Height="40" Source="/Airlines_Сабитов;component/Images/airIcon.png"/>
                    <Label Margin="5,0,0,0" FontWeight="Bold" Foreground="White" 
                           VerticalAlignment="Center" FontSize="18" Content="Управление авиалиниями"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <Button HorizontalAlignment="Right" Height="30" 
                        Margin="10" Padding="30,0,30,0" FontSize="18" Content="Выход"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="1"  Background="Blue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1">
                <StackPanel>
                    <Label Margin="0,0,0,0" FontWeight="Bold" Foreground="White" 
                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="26" 
                           Content="Поиск дешёвых авиабилетов"/>
                    <Label Margin="0,10,0,0" Foreground="White" 
                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" 
                           Content="Лучший способо купить авиабилеты дёшево"/>
                    <Label Margin="0,-10,0,0" Foreground="White" 
                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="1" 
                           Content="Ещё дешевле ищите на Авиасейлс"/>
                    <Label Margin="0,10,0,0" Foreground="White" 
                           VerticalAlignment="Center" FontSize="12" 
                           Content="Откуда"/>
                    <TextBox Height="30"/>
                    <Label Margin="0,10,0,0" Foreground="White" 
                           VerticalAlignment="Center" FontSize="12" 
                           Content="Куда"/>
                    <TextBox Height="30"/>
                    <Button HorizontalAlignment="Right" Height="30" 
                            Click="Hide"
                        Margin="0,10,0,0" Background="Red" Foreground="White"
                            Padding="30,0,30,0" FontSize="18" Content="Найти"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" >

        </Grid>
    </Grid>
</Page>
