<Page x:Class="Airlines_Сабитов.Pages.Ticket"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Airlines_Сабитов.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Ticket">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>
        <Grid Background="Blue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid>
                <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                    <Image Width="40" Height="40" Source="/Airlines_Сабитов;component/Images/airIcon.png"/>
                    <Label Margin="5,0,0,0" FontWeight="Bold" Foreground="White" 
                        VerticalAlignment="Center" FontSize="18" Content="Управление авиалиниями"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1">
                <Button HorizontalAlignment="Right" Height="30" 
                     Margin="10" Padding="30,0,30,0" FontSize="18" Content="Выход"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="1"  Background="White">
            <ScrollViewer>
                <StackPanel x:Name="parrent" Margin="5">
                    
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="2" >
        </Grid>
    </Grid>
</Page>
