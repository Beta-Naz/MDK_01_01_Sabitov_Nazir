<Page x:Class="AppKeyPass.Pages.Registration"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppKeyPass.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Registration">
    <Grid>
        <StackPanel>
        <Label Content="Login:" Height="25"/>
        <TextBox x:Name="tbLogin" Height="25"/>
        <Label Content="Password:" Height="25"/>
            <PasswordBox x:Name="tbPassword" Height="25"/>
        </StackPanel>
        <Grid>
            <Button Click="BtnExit" Content="Выход" Height="25" Width="100" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            <Button Click="BtnCreate" Content="Создать" Height="25" Width="100" Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Page>
