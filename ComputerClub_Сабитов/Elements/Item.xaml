<UserControl x:Class="ComputerClub_Сабитов.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ComputerClub_Сабитов.Elements"
             mc:Ignorable="d">
    <Grid Background="Wheat">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid>
            <StackPanel x:Name="parrent">
                <Image Width="50" Height="50"/>
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="Address" Text="Пермский край, с. Кояново"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                               x:Name="Id" Text="0" Padding="5"/>
                </Grid>
                <Grid Grid.Column="1">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                               x:Name="Name" Text="Igra" Padding="5"/>
                </Grid>
                <Grid x:Name="BtnDelete" Grid.Column="2">
                    <Button Click="Delete_Click" Background="Red" Content="Delete" Foreground="white" FontWeight="Bold"/>
                </Grid>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                               x:Name="StartAndEndTime" Text="12.12.2007 12:30 - 12.12.2007 17:30" Padding="5"/>
                </Grid>
                <Grid x:Name="BtnEdit" Grid.Column="1">
                    <Button Click="Edit_Click" Background="Blue" Content="Edit" Foreground="white" FontWeight="Bold"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
