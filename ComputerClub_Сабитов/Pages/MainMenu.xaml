<Page x:Class="ComputerClub_Сабитов.Pages.MainMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ComputerClub_Сабитов.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainMenu">

    <Page.Background>
        <ImageBrush ImageSource="/Image/Background.png" Stretch="UniformToFill"/>
    </Page.Background>

    <Grid>
        <Rectangle Fill="#CC000000"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Background="Wheat">
                <Border Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center" 
                        CornerRadius="30" Background="Gray">
                    <TextBlock x:Name="Title" Padding="15" FontSize="40" Text="Компьютерные клубы" 
                               Foreground="White" FontWeight="Bold"/>
                </Border>
                <Button Click="Club_Click" Content="PlayerComputer" VerticalAlignment="Center" HorizontalAlignment="Right" Height="40" Width="150" Margin="15"/>
                <Button Click="Player_Click" Content="CompiterClub" VerticalAlignment="Center" HorizontalAlignment="Left" Height="40" Width="150" Margin="15"/>
            </Grid>
            <Grid Grid.Row="1">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="parrent" Margin="15"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
