<UserControl x:Class="Documents_Сабитов.Elements.User.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Documents_Сабитов.Elements.User"
             mc:Ignorable="d" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Наименование:" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="0" Margin="10"/>
        <Label Content="Ответственный" VerticalAlignment="Top" Grid.Column="0" Margin="10, 35"/>
        <Label x:Name="lCode" Content="Код: " VerticalAlignment="Top" Grid.Column="0" Margin="10, 60"/>

        <Label x:Name="lFirstName" Content="Фамилия:" VerticalAlignment="Top" Grid.Column="1" Margin="10"/>
        <Label x:Name="lLastName" Content="Имя:" VerticalAlignment="Top" Grid.Column="1" Margin="10, 35"/>
        <Label x:Name="lForename" Content="Отчество:" VerticalAlignment="Top" Grid.Column="1" Margin="10, 60"/>

        <Button
            Content="Удалить"
            Click="DeleteDocument"
            Grid.Column="1"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Margin="0,85,10,0"
            Width="100"
            Height="25"
            Background="White"/>

        <Button
            Content="Изменить"
            Click="EditDocument"
            Grid.Column="1"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Margin="0,85,120,0"
            Width="100"
            Height="25"
            Background="White"/>
    </Grid>
</UserControl>
