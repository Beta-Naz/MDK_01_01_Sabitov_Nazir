<Page x:Class="Documents_Сабитов.Pages.UserPages.Add"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Documents_Сабитов.Pages.UserPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Add">
    <Grid>
        <Grid
    Height="50"
    VerticalAlignment="Top"
    Background="#FFA0A0A0">
            <Image
        Width="30"
        Height="30"
        VerticalAlignment="Top"
        HorizontalAlignment="Left"
        Margin="10" 
        Source="/Image/icon.png"/>
            <Label
        Foreground="White"
        Content="Добавить документ"
        HorizontalContentAlignment="Center"
        VerticalAlignment="Center"
        FontSize="20"
        FontWeight="Bold"/>
            <Button
        Content="Вернуться"
        Width="75"
        Click="Back"
        Height="25"
        VerticalAlignment="Top"
        HorizontalAlignment="Right"
        Margin="10"
        Background="White"/>
        </Grid>
        <Label
            Content="Укажите фамилию:"
            VerticalAlignment="Top"
            Margin="10,60,10,0"/>
        <TextBox
            Height="25"
            x:Name="tbFirstName"
            VerticalAlignment="Top"
            Margin="10,85,10,0"/>
        <Label
            Content="Укажите имя:"
            VerticalAlignment="Top"
            Margin="10,110,10,0"/>
        <Label
            Content="Укажите отчество:"
            VerticalAlignment="Top"
            Margin="10,160,10,0"/>
        <TextBox
            Height="25"
            x:Name="tbLastName"
            VerticalAlignment="Top"
            Margin="10,185,10,0"/>
        <TextBox
            Height="25"
            x:Name="tbForename"
            VerticalAlignment="Top"
            Margin="10,135,10,0"/>
        <Button
         x:Name="bthAdd"
         Content="Сохранить"
            Click="AddUser"
         Width="75"
         Height="25"
         VerticalAlignment="Top"
         HorizontalAlignment="Right"
         Margin="170,340,10,0"
         Background="White"/>
    </Grid>
</Page>
