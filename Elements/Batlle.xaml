<UserControl x:Class="Batlle_Сабитов.Elements.Batlle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Batlle_Сабитов.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Image x:Name="BackGround" VerticalAlignment="Top" Stretch="UniformToFill" Source="/Batlle_Сабитов;component/Images/Background/Фон_локация_1.png"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400*"/>
                <ColumnDefinition Width="400*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" MouseLeftButtonDown="Player_Click" Cursor="Hand">
                <Border VerticalAlignment="Top" Width="200" Height="250" Margin="0,10,0,0" 
                BorderBrush="DarkGoldenrod"
                BorderThickness="5"
                CornerRadius="5">
                    <Image x:Name="PlayerImages" Stretch="UniformToFill" Source="/Batlle_Сабитов;component/Images/Солдат_лб.png"/>
                </Border>
                <Label x:Name="PlayerName" Content="Солдат в легкой броне" VerticalAlignment="Center" FontWeight="Bold"  HorizontalAlignment="Center" FontSize="18" Foreground="Aquamarine" Margin="0,85,0,0"/>
                <Grid Margin="50,290,200,20" Background="#99B8860B">
                    <Label x:Name="PlayerHealt" Content="Здоровье:" VerticalAlignment="Top" Foreground="white" HorizontalAlignment="Left" Margin="0"/>
                    <Label x:Name="PlayerDamage" Content="Урон:" VerticalAlignment="Top" Foreground="white" HorizontalAlignment="Left" Margin="0,25,0,0"/>
                    <Label x:Name="PlayerDexterity" Content="Ловкость:" VerticalAlignment="Top" Foreground="white" HorizontalAlignment="Left" Margin="0,50,0,0"/>
                    <Label x:Name="PlayerEXP" Content="Опыт" VerticalAlignment="Top" Foreground="white" HorizontalAlignment="Left" Margin="0,75,0,0"/>
                </Grid>
            </Grid>
            <Grid x:Name="SpawnMonsters" Grid.Column="1">
            </Grid>
        </Grid>
        <Grid x:Name="Turn" VerticalAlignment="Top" HorizontalAlignment="Center" Width="100" Height="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="TurnOne" Background="Green" Width="15" Height="15" CornerRadius="15"/>
            <Border x:Name="TurnTwo" Grid.Column="1" Background="Green" Width="15" Height="15" CornerRadius="15"/>
            <Border x:Name="TurnThree" Grid.Column="2"  Background="Green" Width="15" Height="15" CornerRadius="15"/>
            <Border x:Name="TurnFour" Grid.Column="3" Background="Red" Width="15" Height="15" CornerRadius="15"/>
            <Border x:Name="TurnFive" Grid.Column="4" Background="Red" Width="15" Height="15" CornerRadius="15"/>
        </Grid>
        <Grid x:Name="BossHealt" VerticalAlignment="Bottom" Height="10" Margin="20,0,20,5">

        </Grid>
        <Grid Margin="118,-44,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="166" Height="249">
            <Grid x:Name="Avoidance" Height="250" VerticalAlignment="Top">
                <Label x:Name="TextAvoidance" Content="" FontWeight="Bold" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
