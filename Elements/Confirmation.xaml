<UserControl x:Class="Batlle_Сабитов.Elements.Confirmation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Batlle_Сабитов.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid Background="#FF27AE60">
            <Label x:Name="NameLocation" Content="Название локации" Foreground="White" FontSize="12" VerticalAlignment="Center" Padding="0" HorizontalAlignment="Center"/>
        </Grid>
        <Grid Background="#FFFFFFFF" Grid.Row="1">
            <Label Content="Вы точно хотите перейти на данную локацию?" VerticalAlignment="Center" Foreground="Black" FontSize="13" HorizontalAlignment="Left"/>
        </Grid>
        <Grid Background="#FFEAEDED" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Click="No_Click" Grid.Column="0" Margin="2" Padding="0" Foreground="White" FontWeight="Bold" FontSize="10" Content="Отмена" Background="Red" BorderBrush="Red"/>
            <Button Click="Yes_Click" Grid.Column="1" Margin="2" Padding="0" Background="LightGreen" Foreground="White" FontSize="10" Content="Продолжить" FontWeight="Bold" BorderBrush="LightGreen"/>
        </Grid>
    </Grid>
</UserControl>
