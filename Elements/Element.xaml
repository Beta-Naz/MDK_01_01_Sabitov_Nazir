<UserControl x:Class="Book_Сабитов.Elements.Element"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Book_Сабитов.Elements"
             mc:Ignorable="d">
    <Grid Height="100" Background="#FF6AADED" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="tbName" Text="Наименование: Данкешон" Margin="10,10,9.8,0" 
                   VerticalAlignment="Top" Foreground="White" FontWeight="Bold" Grid.ColumnSpan="3"/>
        <TextBlock x:Name="tbGenre" Text="Жанр: 111111111111111111111111111111111111111111" Margin="10,36,9.8,0" 
                   VerticalAlignment="Top" Foreground="White"  TextWrapping="Wrap"/>
        <TextBlock x:Name="tbAuthor" Text="Автор: 111111111111111111111111111111111111111111" Margin="9.2,36,9.8,0" 
                   VerticalAlignment="Top" Foreground="White" TextWrapping="Wrap" Grid.Column="1"/>

    </Grid>
</UserControl>
