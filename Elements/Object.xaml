<UserControl x:Class="Batlle_Сабитов.Elements.Object"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Batlle_Сабитов.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="235">
    <Grid Background="#801A1007" MouseLeftButtonDown="Buy">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Margin="5">
            <Image x:Name="ImagesProduct" Source="/Batlle_Сабитов;component/Images/Object/Малое_зелье_здоровья.png"/>
        </Border>
        <Grid Grid.Column="1">
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="15" Height="15" CornerRadius="100" Margin="5" Background="Gold">
                <Label Content="Р" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="DarkGoldenrod"/>
            </Border>
            <Label x:Name="NameProduct" FontWeight="Bold" Content="Малое зелье здоровье" VerticalAlignment="Center" FontSize="11" Padding="0" HorizontalAlignment="Left" Foreground="White"/>
            <Label x:Name="Price" Content="10" VerticalAlignment="Bottom" FontSize="10" Padding="0" Margin="0,0,25,6" HorizontalAlignment="Right" Foreground="Gold"/>
        </Grid>
    </Grid>
</UserControl>
