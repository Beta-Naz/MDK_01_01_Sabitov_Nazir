<UserControl x:Class="Batlle_Сабитов.Elements.ObjectProductToInvent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Batlle_Сабитов.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="235">
    <Grid Background="#801A1007" MouseLeftButtonDown="Use" Cursor="Hand">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Margin="5">
            <Image x:Name="ImagesProduct" Source="/Batlle_Сабитов;component/Images/Object/Малое_зелье_здоровья.png"/>
        </Border>
        <Grid Grid.Column="1">
            <Label x:Name="NameProduct" FontWeight="Bold" Content="Малое зелье здоровье" VerticalAlignment="Center" FontSize="11" Padding="0" HorizontalAlignment="Left" Foreground="White"/>
            <Label x:Name="DescriptionProduct" FontWeight="DemiBold" Content="Востановление: +50" VerticalAlignment="Top" FontSize="7" Padding="0" HorizontalAlignment="Left" Foreground="LightGreen" Margin="0,57,0,0"/>
        </Grid>
    </Grid>
</UserControl>
