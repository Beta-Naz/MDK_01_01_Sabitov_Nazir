<UserControl x:Class="Batlle_Сабитов.Elements.OneMonster"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Batlle_Сабитов.Elements"
             mc:Ignorable="d" 
                      d:DesignHeight="450" d:DesignWidth="400">
    <Grid x:Name="FirstMonstr" MouseLeftButtonDown="FirstMonster_Click" Cursor="Hand">
        <Border x:Name="FirstMonsterBorder" VerticalAlignment="Top" Width="250" Height="250" Margin="0,10,0,0"
                BorderBrush="DarkCyan"
                BorderThickness="4"
                CornerRadius="5">
            <Image x:Name="ImageMonster" Stretch="UniformToFill" Source="/Batlle_Сабитов;component/Images/Скелет.png"/>
        </Border>
        <Label x:Name="OneMonstrPower" Content="???" VerticalAlignment="Bottom" FontWeight="Bold" HorizontalAlignment="Center" FontSize="30" Foreground="Green" Margin="0,0,0,110"/>
        <Border Background="#40000000" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,90" Height="20">
            <Border x:Name="FirstHealtMaxBarMonster" Background="#7F8B0000" 
                CornerRadius="1"
                Margin="2"
                Width="270">
                <Border x:Name="FirstHealtBarMonster" Background="Red" HorizontalAlignment="Left" Width="270" CornerRadius="1">
                </Border>
            </Border>
        </Border>
    </Grid>
</UserControl>
