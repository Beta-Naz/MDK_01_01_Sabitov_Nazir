<UserControl x:Class="Batlle_Сабитов.Elements.PeacefulWorld"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Batlle_Сабитов.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid Margin="-20,-20,-20,-20">
        <Grid x:Name="Anim" Margin="20,20,20,20">
            <Image x:Name="ImagesVictory" Stretch="UniformToFill" Source="/Batlle_Сабитов;component/Images/The end/Фон_побежденный_бог.png"/>
        </Grid>
        <Grid Margin="20,20,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="800" Height="200">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label x:Name="EndVictory" Content="Победа" Foreground="Transparent" FontWeight="Bold"  HorizontalAlignment="Center" VerticalAlignment="Center"
                        FontSize="60"/>
                <Label x:Name="EndVictoryText" Grid.Row="1" Content="Бог повержен, наступают мирные времена" Foreground="Transparent" FontWeight="DemiBold"  HorizontalAlignment="Center" VerticalAlignment="Top"
                        FontSize="30"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="VictoryButton" Grid.Column="1">
                </Grid>
            </Grid>
        </Grid>
        
        <Grid Margin="252,-1000,0,-1000" Width="400" HorizontalAlignment="Left">
            <Grid x:Name="Titri" Height="2700" VerticalAlignment="Top">
                <Grid Background="#CC000000" VerticalAlignment="Bottom">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Height="930">
                        <TextBlock Text="ФИНАЛЬНЫЕ ТИТРЫ" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,50"/>
                        <TextBlock Text="РАЗРАБОТКА" FontSize="20" FontWeight="SemiBold" Foreground="LightGray" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Сабитов Н.Н." FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                        <TextBlock Text="ПРОГРАММИРОВАНИЕ" FontSize="20" FontWeight="SemiBold" 
                          Foreground="LightGray" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Сабитов Н.Н." FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                        <TextBlock Text="ДИЗАЙН" FontSize="20" FontWeight="SemiBold" Foreground="LightGray" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Сабитов Н.Н." FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Ширинкин И.С." FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                        <TextBlock Text="ТЕСТИРОВАНИЕ" FontSize="20" FontWeight="SemiBold" Foreground="LightGray" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Сабитов Н.Н." FontSize="16" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                        <TextBlock Text="ОСОБАЯ БЛАГОДАРНОСТЬ" FontSize="18" FontWeight="SemiBold" Foreground="Gold" HorizontalAlignment="Center" Margin="0,50,0,20"/>
                        <TextBlock Text="Моему кипятиильнику(Мой ноутбук)" FontSize="14" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="Моей спине (Практика заняла +- 30 часов)" FontSize="14" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,60"/>
                        <TextBlock Text="СПАСИБО ЗА ИГРУ!" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,50,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
