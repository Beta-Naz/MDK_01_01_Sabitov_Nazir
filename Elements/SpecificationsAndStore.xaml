<UserControl x:Class="Batlle_Сабитов.Elements.SpecificationsAndStore"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Batlle_Сабитов.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="900">
    <Grid>
        <Image Stretch="UniformToFill" Source="/Batlle_Сабитов;component/Images/Background/Гильдия.png"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="10*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="2" Background="#CC2A1B0F" CornerRadius="8" Padding="5" Margin="10">
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Visible">
                        <StackPanel x:Name="Shop" Orientation="Vertical">

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            <Border Grid.Column="1" Background="#CC2A1B0F" CornerRadius="8" Padding="5" Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14*"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Image x:Name="PlayerImages" Source="/Batlle_Сабитов;component/Images/Солдат_лб.png" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Grid Grid.Row="1">
                            <Border Margin="1" Background="#40000000" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border x:Name="HealtMaxBarPlayer" Background="#7F8B0000" 
                                    CornerRadius="1"
                                        Margin="3"
                                        Height="7"
                                        Width="180">
                                    <Border x:Name="HealtBarPlayer" Background="Red" HorizontalAlignment="Left" Width="180" CornerRadius="1"/>
                                </Border>
                            </Border>
                            <Label x:Name="TextHealtPlayer" VerticalAlignment="Center" Foreground="DarkRed" HorizontalAlignment="Center" FontWeight="Bold" FontSize="7" Content="999" Padding="0"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Label x:Name="PlayerName" Content="Солдат в легкой броне" VerticalAlignment="Top" FontWeight="Bold"  HorizontalAlignment="Center" FontSize="18" Foreground="Aquamarine"/>
                        <Grid Margin="0,35,0,0"  Background="#801A1007">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Padding="0" Grid.Column="0" Content="Уровень:" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left"/>
                                <Label Padding="0" Grid.Column="1" x:Name="PlayerLevel" Content="1" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center"/>
                                <Label Padding="0" Grid.Column="2" Content="Очки навыков:" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left"/>
                                <Label Padding="0" Grid.Column="3" x:Name="PlayerSkillPoints" Content="0" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Label Padding="0" Content="МаксЗдоровье:" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left"/>
                                    <Label Padding="0" Grid.Row="1"  Content="Урон:" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left"/>
                                    <Label Padding="0" Grid.Row="2"  Content="Ловкость:" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left"/>
                                    <Label Padding="0" Grid.Row="3"  Content="Броня:" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left"/>
                                    <Label Padding="0" Grid.Row="4"  Content="Тип брони:" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="0,6,0,0"/>

                                    <Label Padding="0" Grid.Column="1" x:Name="PlayerMaxHealt" Content="0" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center"/>
                                    <Label Padding="0" Grid.Column="1"  Grid.Row="1" x:Name="PlayerDamage" Content="0" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center"/>
                                    <Label Padding="0" Grid.Column="1"  Grid.Row="2" x:Name="PlayerDexterity" Content="0" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center"/>
                                    <Label Padding="0" Grid.Column="1"  Grid.Row="3" x:Name="PlayerArmor" Content="0" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center"/>
                                    <Label Padding="0" Grid.Column="1"  Grid.Row="4" x:Name="PlayerTypeArmor" Content="0" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center"/>

                                    <Grid Grid.Row="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Width="15" Height="15" CornerRadius="100" Background="Gold">
                                            <Label Content="Р" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="DarkGoldenrod"/>
                                        </Border>
                                        <Label Content="Монет:" VerticalAlignment="Center" Padding="0" Margin="0" HorizontalAlignment="Left" Foreground="Gold"/>
                                        <Label Grid.Column="1" x:Name="PlayerMoney" Content="10" VerticalAlignment="Center" Padding="0" Margin="0" HorizontalAlignment="Center" Foreground="Gold"/>
                                    </Grid>
                                </Grid>
                                <Grid  Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition Height="3*"/>
                                    </Grid.RowDefinitions>
                                    <Button Click="UppHealt_Click" Margin="1" Padding="0" Background="DarkGray" Foreground="White" FontSize="10" Content="Прокачать" FontWeight="Bold" BorderBrush="DarkGray"/>
                                    <Button Grid.Row="1" Click="UppDamage_Click" Margin="1" Padding="0" Background="DarkGray" Foreground="White" FontSize="10" Content="Прокачать" FontWeight="Bold" BorderBrush="DarkGray"/>
                                    <Button Grid.Row="2"  Click="UppDexterity_Click" Margin="1" Padding="0" Background="DarkGray" Foreground="White" FontSize="10" Content="Прокачать" FontWeight="Bold" BorderBrush="DarkGray"/>
                                    <Grid Grid.Row="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="2.6*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Label Padding="0" Content="Оружие" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="1">
                                            <Image x:Name="WeaponImages" Source="/Batlle_Сабитов;component/Images/Object/Без_оружия.png"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" CornerRadius="8" Padding="5" Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid  Background="#CC2A1B0F">
                        <Border Background="#CC2A1B0F" CornerRadius="8" Padding="5" Margin="0">
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Visible">
                                <StackPanel x:Name="Inventory" Orientation="Vertical">

                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Button Click="Return_Click" Grid.Column="1" Margin="2" Padding="0" Background="Red" Foreground="White" FontSize="20" Content="Вернуться" FontWeight="Bold" BorderBrush="Red"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
