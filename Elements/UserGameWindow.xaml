<UserControl x:Class="Batlle_Сабитов.Elements.UserGameWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Batlle_Сабитов.Elements"
             mc:Ignorable="d">
    <Grid Height="450" x:Name="MainWindow" Background="DarkGoldenrod">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="LbSoldat" VerticalAlignment="Top" Margin="50,10,50,0" Source="/Batlle_Сабитов;component/Images/Солдат_лб.png"/>
        <Image x:Name="SbSoldat" VerticalAlignment="Top" Margin="50,10,50,0" Grid.Column="1" Source="/Batlle_Сабитов;component/Images/Солдат_сб.png"/>
        <Image x:Name="TbSoldat" VerticalAlignment="Top" Margin="50,10,50,0" Grid.Column="2" Source="/Batlle_Сабитов;component/Images/Солдат_тб.png"/>

        <Label Content="Солдат в легкой броне" VerticalAlignment="Center" FontWeight="Bold"  HorizontalAlignment="Center" FontSize="18" Foreground="Aquamarine" Margin="0,110,0,0"/>
        <Label x:Name="Lbhealt" Content="Здоровье: 100" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,165,0,0"/>
        <Label x:Name="LbArmor" Content="Броня: 10" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,220,0,0"/>
        <Label x:Name="LbDexterity" Content="Ловкость: 50" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,275,0,0"/>
        <Label x:Name="LbdDamage" Content="Урон: 25" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,330,0,0"/>
        <Label x:Name="LbdTypeArmor" Content="Тип брони: кожа" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,385,0,0"/>
        <Button Click="Lb_Click" Background="Transparent" BorderBrush="Transparent"/>

        <Label Content="Солдат в средней броне"  Grid.Column="1" VerticalAlignment="Center"  FontWeight="Bold"  HorizontalAlignment="Center" FontSize="18" Foreground="Yellow" Margin="0,110,0,0"/>
        <Label x:Name="Mbhealt" Content="Здоровье: 100" Grid.Column="1" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,165,0,0"/>
        <Label x:Name="MbArmor" Content="Броня: 50"  Grid.Column="1" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,220,0,0"/>
        <Label x:Name="MbDexterity" Content="Ловкость: 20"  Grid.Column="1" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,275,0,0"/>
        <Label x:Name="MbdDamage" Content="Урон: 40"  Grid.Column="1" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,330,0,0"/>
        <Label x:Name="MbdTypeArmor" Content="Тип брони: хитин"  Grid.Column="1" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,385,0,0"/>
        <Button Click="Mb_Click" Grid.Column="1" Background="Transparent" BorderBrush="Transparent"/>

        <Label Content="Солдат в тяжелой броне"  Grid.Column="2" VerticalAlignment="Center"  FontWeight="Bold"  HorizontalAlignment="Center" FontSize="18" Foreground="Red" Margin="0,110,0,0"/>
        <Label x:Name="Hbhealt" Content="Здоровье: 100" Grid.Column="2" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,165,0,0"/>
        <Label x:Name="HbArmor" Content="Броня: 90"  Grid.Column="2" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,220,0,0"/>
        <Label x:Name="HbDexterity" Content="Ловкость: 1"  Grid.Column="2" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,275,0,0"/>
        <Label x:Name="HbdDamage" Content="Урон: 55"  Grid.Column="2" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,330,0,0"/>
        <Label x:Name="HbdTypeArmor" Content="Тип брони: адамантий"  Grid.Column="2" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Left" Margin="20,385,0,0"/>
        <Button Click="Hb_Click" Grid.Column="2" Background="Transparent" BorderBrush="Transparent"/>
    </Grid>
</UserControl>
