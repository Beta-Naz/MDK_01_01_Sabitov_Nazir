<UserControl x:Class="FurnitureStore_Сабитов.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FurnitureStore_Сабитов.Elements"
             mc:Ignorable="d">
    <Grid Width="200">
        <Grid Margin="15,15,15,15" Background="#7FFFFFFF" Height="300">
            <Image x:Name="image" Margin="-10,-10,-10,120" Stretch="UniformToFill" 
                   Source="FurnitureStore_Сабитов;component/Images/background.jpg"/>
            <Label x:Name="price" Content="3000 р." Margin="10,180,10,94" HorizontalContentAlignment="Center" 
                   VerticalContentAlignment="Center" FontWeight="Bold" Foreground="Black"/>
            <Label x:Name="name" Content="Наименование." Margin="10,208,10,66" HorizontalContentAlignment="Center" 
                   VerticalContentAlignment="Center" FontWeight="Bold" Foreground="Black"/>
            <Button Content="-" Click="ButtonMinus_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="30" Height="25" Margin="10,0,0,38"/>
            <TextBox x:Name="countTovar"  Text="0" Height="25" Margin="45,0,45,38" VerticalAlignment="Bottom" HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"/>
            <Button Content="+" Click="ButtonPlus_Click" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="30" Height="25" Margin="0,0,10,38"/>
            <Button Content="В корзину" Click="Button_Click" VerticalAlignment="Bottom" Height="25" Margin="10,0,10,10"/>
        </Grid>
    </Grid>
</UserControl>
