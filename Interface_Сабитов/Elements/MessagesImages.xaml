<UserControl x:Class="Interface_Сабитов.Elements.MessagesImages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Interface_Сабитов.Elements"
             mc:Ignorable="d" MouseDoubleClick="DeleteMessage">
    <Grid Background="Black" Margin="5">
        <Border CornerRadius="15" Height="30" Width="30" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border.Background>
                <ImageBrush ImageSource="/Interface_Сабитов;component/Images/aooshchepkov.jpg"/>
            </Border.Background>
        </Border>
        <Border Height="400" Width="400" CornerRadius="5" Margin="45,40,10,35" Padding="5">
            <Border.Background>
                <ImageBrush Stretch="Uniform" x:Name="SendImages" ImageSource="/Interface_Сабитов;component/Images/aooshchepkov.jpg"/>
            </Border.Background>
        </Border>
        <TextBlock x:Name="Date" Margin="0,0,0,0" Padding="5" TextWrapping="Wrap" HorizontalAlignment="Right" 
                   VerticalAlignment="Bottom" Text="11.09.2007" Foreground="White" Width="70"/>
        <Grid.Effect>
            <DropShadowEffect/>
        </Grid.Effect>
    </Grid>
</UserControl>
