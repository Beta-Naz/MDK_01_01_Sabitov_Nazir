<Window x:Class="Book_Сабитов.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Book_Сабитов"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="450" 
        Width="800"
        MinHeight="450" 
        MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid Margin="0,0,-0.4,0" Height="120" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Label Content="#Поиск по наименованию:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <Label Content="#Сортировка:" HorizontalAlignment="Left" Margin="10,64,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <TextBox x:Name="tbSearch" KeyUp="Search_Book" Height="23" Margin="10,36,9.6,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
            <ComboBox x:Name="cdAuthors" Margin="10,90,9.8,0" VerticalAlignment="Top" SelectionChanged="SelectAuthor"/>
            <ComboBox x:Name="cdGenres" Margin="10,90,9.8,0" VerticalAlignment="Top" Grid.Column="1" SelectionChanged="SelectGenres"/>
            <ComboBox x:Name="cdYear" Margin="10,90,9.8,0" VerticalAlignment="Top" Grid.Column="2" SelectionChanged="SelectYear"/>
        </Grid>
        <ScrollViewer Margin="0,120,-0.4,0">
            <StackPanel x:Name="parent">
                
            </StackPanel>
        </ScrollViewer>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Button Click="Import" Content="Импорт" Foreground="White" FontWeight="Bold" FontSize="18" Padding="0" Background="Red" BorderBrush="Red" Margin="5"/>
            <Button Click="Export" Content="Экспорт" Foreground="White" FontWeight="Bold" FontSize="18" Padding="0" Grid.Column="1" Background="LightGreen" BorderBrush="LightGreen" Margin="5"/>
        </Grid>
    </Grid>
</Window>
