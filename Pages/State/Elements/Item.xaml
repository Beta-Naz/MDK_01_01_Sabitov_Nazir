<UserControl x:Class="VinylRecordsApplication_Sabitov.Pages.State.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VinylRecordsApplication_Sabitov.Pages.State.Elements"
             mc:Ignorable="d">
    <Grid>
        <Border BorderBrush="#AFAFAF" Margin="0,0,0,20" BorderThickness="1" Background="#FFFFFF" CornerRadius="20" VerticalAlignment="Top" Height="160">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Black" Direction="315" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>
            <Grid Margin="15">
                <Image Width="68" Height="68" VerticalAlignment="Top" HorizontalAlignment="Left" Source="/VinylRecordsApplication_Sabitov;component/Resourses/Images/ic_State.png"/>
                <Button Content="Изменить" HorizontalAlignment="Left" VerticalAlignment="Top" Width="68" Height="25" BorderBrush="#FF9800" Background="#FF9800" Foreground="White" FontWeight="Bold" Margin="0,73,0,0" Click="EditState">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10" Color="Black" Direction="315" ShadowDepth="2" Opacity="0.5"/>
                    </Button.Effect>
                </Button>
                <Button Content="Удалить" HorizontalAlignment="Left" VerticalAlignment="Top" Width="68" Height="25" BorderBrush="Red" Background="Red" Foreground="White" FontWeight="Bold" Margin="0,103,0,0" Click="DeleteState">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10" Color="Black" Direction="315" ShadowDepth="2" Opacity="0.5"/>
                    </Button.Effect>
                </Button>
                <Grid Margin="73,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel>
                            <Label Content="Наименование состояния:"/>
                            <TextBox x:Name="tbName" IsEnabled="False" Height="25" TextWrapping="Wrap" Text="" VerticalContentAlignment="Center" VerticalAlignment="Top" Padding="10,0" Grid.ColumnSpan="2">
                                <TextBox.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="Black" Direction="315" ShadowDepth="2" Opacity="0.5"/>
                                </TextBox.Effect>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Margin="15,0,0,0">
                            <Label Content="Сокращённое наименование:"/>
                            <TextBox x:Name="tbSubname" IsEnabled="False" Height="25" TextWrapping="Wrap" Text="" VerticalContentAlignment="Center" VerticalAlignment="Top" Padding="10,0" Grid.ColumnSpan="2">
                                <TextBox.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="Black" Direction="315" ShadowDepth="2" Opacity="0.5"/>
                                </TextBox.Effect>
                            </TextBox>
                        </StackPanel>
                    </StackPanel>
                    <Label Content="Описание:" Margin="0,51,10,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                    <TextBox x:Name="tbDescription" IsEnabled="False" Margin="0,77,10,0" Height="51" TextWrapping="Wrap" Text="" VerticalContentAlignment="Top" VerticalAlignment="Top" Padding="10,0" Grid.ColumnSpan="2">
                        <TextBox.Effect>
                            <DropShadowEffect BlurRadius="10" Color="Black" Direction="315" ShadowDepth="2" Opacity="0.5"/>
                        </TextBox.Effect>
                    </TextBox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
