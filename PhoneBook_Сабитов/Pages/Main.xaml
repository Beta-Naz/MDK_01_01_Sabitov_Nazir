<Page x:Class="PhoneBook_Сабитов.Pages.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PhoneBook_Сабитов.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="Main">

    <Grid Background="#FFE8E8E8">
        <Grid.Resources>
            <ResourceDictionary Source="/Resource/BtnRes.xaml"/>
        </Grid.Resources>

        <Grid Margin="0,0,0,0" VerticalAlignment="Top" Height="60">
            <Grid.Effect>
                <DropShadowEffect BlurRadius="31" Direction="260" Color="#FFC1C1C1" ShadowDepth="0"/>
            </Grid.Effect>
            <Border CornerRadius="00,00,00,00" Margin="0,0,0,0">
                <Border.Background>
                    <SolidColorBrush Color="#FF2C2C2C" Opacity="1.0"/>
                </Border.Background>
            </Border>
            <Image x:Name="img" Source="/Images/logo.png" Margin="19,8,0,0" HorizontalAlignment="Left" Width="41"
                   Height="42" VerticalAlignment="Top" />
        </Grid>

        <Grid Margin="10,77,10,0" Height="51" VerticalAlignment="Top">
            <StackPanel x:Name="list_move" Orientation="Horizontal">

                <Border x:Name="people_itms" Margin="5,3,10,0" Height="45" CornerRadius="5,5,5,5"
                        Style="{StaticResource Grid_Itm_Anim}" MouseDown="Click_Phone" Padding="7,7,7,7">
                    <Grid Height="30" >
                        <Image Source="/Images/people.png" Margin="5,0,0,0" HorizontalAlignment="Left" Width="29"
                               Height="30" VerticalAlignment="Top"/>
                        <Label x:Name="people_text" Content="Клиенты" Margin="44,0,0,0" Foreground="#FF171717"
                               FontSize="15" FontFamily="Corbel"
                               VerticalContentAlignment="Center" HorizontalContentAlignment="Left" Height="30"
                               VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <Border x:Name="equipment_itms" Margin="5,3,0,0" Height="45" Padding="7,7,7,7"
                        CornerRadius="5,5,5,5" Style="{StaticResource Grid_Itm_Anim}" MouseDown="Click_History">
                    <Grid Height="30">
                        <Image Source="/Images/calls.png" Margin="5,0,0,0" HorizontalAlignment="Left" Width="29"
                               Height="30" VerticalAlignment="Top" />
                        <Label Content="История звонков" Margin="44,0,0,0" Foreground="#FF2C2C2C" FontSize="15"
                               FontFamily="Corbel"
                               VerticalContentAlignment="Center" HorizontalContentAlignment="Left" Height="30"
                               VerticalAlignment="Top"/>
                    </Grid>
                </Border>
                <Border x:Name="sort" Margin="5,3,0,0" Height="45" Padding="7,7,7,7"
                        CornerRadius="5,5,5,5" Background="White">
                    <StackPanel Orientation="Horizontal" Height="30">
                        <Button x:Name="btn_startFilter" Style="{StaticResource BtnRedac}" Background="LightGreen"
                                VerticalAlignment="Bottom" Height="30"
                                Click="btn_startFilter_Click" HorizontalAlignment="Left" Width="30">
                            <Image Source="/Images/ok.png" Width="20" Height="20"/>
                        </Button>
                        <Button x:Name="btn_removeFilter" Style="{StaticResource BtnRedac}" Background="#FFE42B2B"
                                VerticalAlignment="Bottom" Height="30"
                                Click="btn_removeFilter_Click" HorizontalAlignment="Left" Width="30">
                            <Image Source="/Images/del.png" Width="20" Height="20"/>
                        </Button>
                        <DatePicker Style="{StaticResource styleDatePicker}" x:Name="date_start_call" Width="100"  Margin="5,0,0,0" Height="30" VerticalAlignment="Top"
                                        FontFamily="Yu Gothic UI Light" FontSize="8"/>
                        <DatePicker Style="{StaticResource styleDatePicker}" x:Name="date_end_call" Width="100" Margin="5,0,0,0" Height="30" VerticalAlignment="Top"
                                        FontFamily="Yu Gothic UI Light" FontSize="8"/>
                        <ComboBox x:Name="call_category_text" FontFamily="Yu Gothic UI Semilight" Margin="5,0,0,0"  Width="100" Height="30" VerticalAlignment="Top"
                                  FontSize="14"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Margin="10,133,10,10" CornerRadius="10,10,10,10">
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="1.0"/>
            </Border.Background>

            <Grid MinHeight="300">
                <ScrollViewer x:Name="scroll_main">
                    <StackPanel x:Name="parrent">

                    </StackPanel>
                </ScrollViewer>
                <Frame x:Name="frame_main" NavigationUIVisibility="Hidden" Visibility="Hidden" Opacity="0"/>
            </Grid>
        </Border>
    </Grid>
</Page>
