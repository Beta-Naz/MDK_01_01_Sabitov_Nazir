<Window x:Class="Regex_Сабитов.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Regex_Сабитов"
        mc:Ignorable="d"
        Title="Papers, Please" 
        Icon="pack://application:,,,/Regex_Сабитов;component/Images/Icon.png"
        Height="450" 
        Width="800"
        MinHeight="450" 
        MinWidth="800"
        Background="#5a5a5a">
    <Grid>
        <ListView Background="#b8b19a" x:Name="lv_passport" Margin="10,10,10,40">
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="#6d5d4f"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="Black"/>
                    <Setter Property="BorderThickness" Value="4"/>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Фото" Width="100"> <!--Я считаю, то что без гугла была нельзя это сделать-->
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding PhotoPassport}" Stretch="UniformToFill"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Имя" Width="100" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Фамилия" Width="100" DisplayMemberBinding="{Binding FirstName}"/>
                    <GridViewColumn Header="Отечество" Width="100" DisplayMemberBinding="{Binding Forename}"/>
                    <GridViewColumn Header="Паспорт" Width="100" DisplayMemberBinding="{Binding Issued}"/>
                    <GridViewColumn Header="Дата выдачи" Width="100" DisplayMemberBinding="{Binding DateOfIssued}"/>
                    <GridViewColumn Header="Код подразделения" Width="100" DisplayMemberBinding="{Binding DepartmentCode}"/>
                    <GridViewColumn Header="Серия и номер" Width="100" DisplayMemberBinding="{Binding SeriesAndNumber}"/>
                    <GridViewColumn Header="Дата рождения" Width="100" DisplayMemberBinding="{Binding DateOfBirth}"/>
                    <GridViewColumn Header="Место рождения" Width="100" DisplayMemberBinding="{Binding PlaceOfBirth}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button Click="Add" Content="Добавить" HorizontalAlignment="Right" Margin="0,0,10,10" 
                VerticalAlignment="Bottom" Width="75" Height="25"/>
        <Button Click="Update" Content="Обновить" HorizontalAlignment="Right" Margin="0,0,90,10" 
                VerticalAlignment="Bottom" Width="75" Height="25"/>
        <Button Click="Delete" Content="Удалить" HorizontalAlignment="Right" Margin="0,0,170,10" 
                VerticalAlignment="Bottom" Width="75" Height="25"/>
        <Label Content="Поиск:" FontSize="18" Padding="0" Foreground="White" HorizontalAlignment="Left" Margin="10,0,0,10" 
                VerticalAlignment="Bottom" Width="60" Height="25"/>
        <TextBox x:Name="PoiskText" TextChanged="Poisk" HorizontalAlignment="Left" Margin="70,0,0,10" 
                VerticalAlignment="Bottom" Width="300" Height="25"/>
    </Grid>
</Window>
