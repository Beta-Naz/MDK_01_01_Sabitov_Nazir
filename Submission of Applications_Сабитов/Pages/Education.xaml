<Page x:Class="Submission_of_Applications_Сабитов.Pages.Education"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Submission_of_Applications_Сабитов.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="792"
      Title="Education">
    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="5.5*"/>
        </Grid.RowDefinitions>
        <Grid Background="White">
            <Image HorizontalAlignment="Left" Height="40" Margin="10,10,0,0" VerticalAlignment="Top" Width="40" Source="pack://application:,,,/Submission of Applications_Сабитов;component/Images/aviat.png"/>
            <Label Content="Электронная приемная компания" HorizontalAlignment="Left" Margin="55,1,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="19"/>
            <Label Content="Пермского авиационного техникума им. А. Д. Швецова" HorizontalAlignment="Left" Margin="55,24,0,0" VerticalAlignment="Top"/>
        </Grid>
        <Grid Grid.Row="1">
            <Label Content="Сведения об образовании" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
            <Label Content="База" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top" />

            <Label Content="Выберите один из вариантов" HorizontalAlignment="Left" Margin="20,67,0,0" 
       VerticalAlignment="Top" Background="{x:Null}" FontSize="10" Foreground="Red"/>

            <RadioButton Content="9 классов" HorizontalAlignment="Left" Margin="22,91,0,0" VerticalAlignment="Top"/>
            <RadioButton Content="11 классов" HorizontalAlignment="Left" Margin="22,106,0,0" VerticalAlignment="Top"/>
            <RadioButton Content="СВО" HorizontalAlignment="Left" Margin="22,121,0,0" VerticalAlignment="Top"/>
            <RadioButton Content="ВПО" HorizontalAlignment="Left" Margin="22,136,0,0" VerticalAlignment="Top"/>
            <Label Content="Выберите один из вариантов" HorizontalAlignment="Left" Margin="20,156,0,0" 
       VerticalAlignment="Top" Background="{x:Null}" FontSize="10" Foreground="Red"/>
            <RadioButton Content="Аттестат" HorizontalAlignment="Left" Margin="22,180,0,0" VerticalAlignment="Top"/>
            <RadioButton Content="Диплом" HorizontalAlignment="Left" Margin="22,195,0,0" VerticalAlignment="Top"/>
            <Grid Margin="10,220,0,0" Height="50" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Label Content="Серию и номер документа об образовании" 
                    HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                    <TextBox Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                </Grid>
                <Grid Margin="10,0,0,0" Grid.Column="1">
                    <Label Content="Средний балл (до сотых)" 
                    HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                    <TextBox Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                </Grid>
            </Grid>
            <Label Content="Прикрепите сканы страниц документа об образовании с Ф.И.О., наименованием образовательной организации и оценками" HorizontalAlignment="Left" 
                Margin="10,275,0,0" VerticalAlignment="Top"/>
            <Label Content="(Формат документов должен быть PNG, JPEG или PDF, а максимальный размер каждого файла 5 МБ)" HorizontalAlignment="Left" Margin="25,300,0,0" 
            VerticalAlignment="Top" Background="{x:Null}" FontSize="10" Foreground="Red"/>
            <Grid Margin="25,325,0,0" Height="20" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Height="20" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                </Grid>
                <Grid Margin="5,0,10,0" Grid.Column="1">
                    <Button Height="20" VerticalAlignment="Top" Content="Выбрать..."/>
                </Grid>
            </Grid>
            <Button Content="Продолжить" HorizontalAlignment="Right" Margin="0,0,10,5" 
                    VerticalAlignment="Bottom" Width="150" Height="25"/>
        </Grid>
    </Grid>
</Page>
