<Page x:Class="Submission_of_Applications_Сабитов.Pages.Passport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Submission_of_Applications_Сабитов.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="690" d:DesignWidth="792"
      Title="Passport">
    <Grid>
        <Grid Background="#F8F9FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Background="White">
                <Image HorizontalAlignment="Left" Height="40" Margin="10,10,0,0" VerticalAlignment="Top" Width="40" Source="pack://application:,,,/Submission of Applications_Сабитов;component/Images/aviat.png"/>
                <Label Content="Электронная приемная компания" HorizontalAlignment="Left" Margin="55,1,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="19"/>
                <Label Content="Пермского авиационного техникума им. А. Д. Швецова" HorizontalAlignment="Left" Margin="55,24,0,0" VerticalAlignment="Top"/>
            </Grid>
            <Grid Grid.Row="1">
                <Label Content="Паспортные данные" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Grid Margin="10,40,0,0" Height="50" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Label Content="Фамилия:" 
                HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                        <TextBox x:Name="firstName" TextChanged="firstName_TextChanged" Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid Margin="10,0,0,0" Grid.Column="1">
                        <Label Content="Имя:" 
                HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                        <TextBox x:Name="name" TextChanged="name_TextChanged" Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid Margin="10,0,0,0" Grid.Column="2">
                        <Label Content="Отчество:" 
                HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                        <TextBox x:Name="forename" Height="24" TextChanged="forename_TextChanged" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
                <Grid Margin="10,100,0,0" Height="50" VerticalAlignment="Top">
                    <Label  Content="Дата рождения:" 
               HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="dateOfBirth" TextChanged="dateOfBirth_TextChanged" Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                </Grid>
                <Grid Margin="10,160,0,0" Height="50" VerticalAlignment="Top">
                    <Label Content="Гражданство:" 
               HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="gras" TextChanged="gras_TextChanged" Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                </Grid>
                <Grid Margin="10,220,0,0" Height="50" VerticalAlignment="Top">
                    <Label Content="Место рождения:" 
               HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                    <TextBox x:Name="placeOfBirth" TextChanged="placeOfBirth_TextChanged" Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                </Grid>
                <Grid Margin="10,280,0,0" Height="50" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Label Content="Серия и номер паспорта:" 
                HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                        <TextBox x:Name="seriaAndNomer" TextChanged="seriaAndNomer_TextChanged" Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid Margin="10,0,0,0" Grid.Column="1">
                        <Label Content="Дата выдачи:" 
                HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                        <TextBox x:Name="dateOfAdd" TextChanged="dateOfAdd_TextChanged" Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid Margin="10,0,0,0" Grid.Column="2">
                        <Label Content="Код подразделения:" 
                HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                        <TextBox x:Name="code" TextChanged="code_TextChanged"  Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
                <Grid Margin="10,340,0,0" Height="50" VerticalAlignment="Top">
                    <Label Content="Кем выдан:" 
               HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                    <TextBox TextChanged="kem_TextChanged" x:Name="kem" Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                </Grid>
                <Grid Margin="10,400,0,0" Height="50" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Label Content="Адрес по прописке:" 
        HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                        <TextBox x:Name="addresForpropiske" TextChanged="addresForpropiske_TextChanged" Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid Margin="10,0,0,0" Grid.Column="1">
                        <Label Content="Район:" 
        HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                        <TextBox TextChanged="raion1_TextChanged" x:Name="raion1" Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
                <Grid Margin="10,460,0,0" Height="50" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Label Content="Адрес проживания фактический:" 
HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                        <TextBox TextChanged="addres_TextChanged" x:Name="addres" Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid Margin="10,0,0,0" Grid.Column="1">
                        <Label Content="Район:" 
HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Top"/>
                        <TextBox TextChanged="raion2_TextChanged" x:Name="raion2" Height="24" Margin="0,25,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
                <Label Content="Прикрепите сканы страниц документа об образовании с Ф.И.О., наименованием образовательной организации и оценками" HorizontalAlignment="Left" 
            Margin="10,520,0,0" VerticalAlignment="Top"/>
                <Label Content="(Формат документов должен быть PNG, JPEG или PDF, а максимальный размер каждого файла 5 МБ)" HorizontalAlignment="Left" Margin="25,545,0,0" 
        VerticalAlignment="Top" Background="{x:Null}" FontSize="10" Foreground="Red"/>
                <Grid Margin="25,570,0,0" Height="20" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="sourseImg" Height="20" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                    </Grid>
                    <Grid Margin="5,0,10,0" Grid.Column="1">
                        <Button Click="OpenImg" Height="20" VerticalAlignment="Top" Content="Выбрать..."/>
                    </Grid>
                </Grid>
                <Button Click="contuniePages" Content="Продолжить" HorizontalAlignment="Right" Margin="0,0,10,5" 
                VerticalAlignment="Bottom" Width="150" Height="25"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
