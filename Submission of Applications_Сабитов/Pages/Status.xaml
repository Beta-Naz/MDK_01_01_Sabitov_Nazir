<Page x:Class="Submission_of_Applications_Сабитов.Pages.Status"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Submission_of_Applications_Сабитов.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="410" d:DesignWidth="792"
      Title="Status">
    <Grid  Background="#F8F9FA">
        <Grid Background="#F8F9FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid Background="White">
                <Image HorizontalAlignment="Left" Height="40" Margin="10,10,0,0" VerticalAlignment="Top" Width="40" Source="pack://application:,,,/Submission of Applications_Сабитов;component/Images/aviat.png"/>
                <Label Content="Электронная приемная компания" HorizontalAlignment="Left" Margin="55,1,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="19"/>
                <Label Content="Пермского авиационного техникума им. А. Д. Швецова" HorizontalAlignment="Left" Margin="55,24,0,0" VerticalAlignment="Top"/>
            </Grid>
            <Grid Grid.Row="1">
                <Label Content="Статус" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Label Content="Имею статус" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top" />
                <Label Content="Отметить при наличии" HorizontalAlignment="Left" Margin="20,67,0,0" 
   VerticalAlignment="Top" Background="{x:Null}" FontSize="10" Foreground="Red"/>
                <CheckBox Content="ребенок-сирота/ребенокб оставшийся без попечения родителей" HorizontalAlignment="Left" Margin="22,91,0,0" VerticalAlignment="Top"/>
                <CheckBox Content="инвалид" HorizontalAlignment="Left" Margin="22,106,0,0" VerticalAlignment="Top"/>
                <CheckBox Content="малообеспеченный" HorizontalAlignment="Left" Margin="22,121,0,0" VerticalAlignment="Top"/>
                <Label Content="Приписное удостоверние (военный билет)" HorizontalAlignment="Left" Margin="10,140,0,0" VerticalAlignment="Top" />
                <Label Content="Выберите один из вариантов" HorizontalAlignment="Left" Margin="20,166,0,0" 
   VerticalAlignment="Top" Background="{x:Null}" FontSize="10" Foreground="Red"/>
                <RadioButton Content="имею (при нажатии данной кнопки необходимо прикрепить сканы страниц документа)" HorizontalAlignment="Left" Margin="22,190,0,0" VerticalAlignment="Top"/>
                <RadioButton Content="не имею" HorizontalAlignment="Left" Margin="22,205,0,0" VerticalAlignment="Top"/>
                <Label Content="Прикрепите сканы 1-ой и 2-ой страниц приписного удостоверения или военного билета (стр. 1-5б 8-13б 20-21)" HorizontalAlignment="Left" 
            Margin="10,225,0,0" VerticalAlignment="Top"/>
                <Label Content="(Формат документов должен быть PNG, JPEG или PDF, а максимальный размер каждого файла 5 МБ)" HorizontalAlignment="Left" Margin="25,250,0,0" 
        VerticalAlignment="Top" Background="{x:Null}" FontSize="10" Foreground="Red"/>
                <Grid Margin="25,275,0,0" Height="20" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Height="20" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid Margin="5,0,10,0" Grid.Column="1">
                        <Button Height="20" VerticalAlignment="Top" Content="Выбрать..."/>
                    </Grid>
                </Grid>
                <Button Content="Продолжить" HorizontalAlignment="Right" Margin="0,0,10,5" 
                VerticalAlignment="Bottom" Width="150" Height="25"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
