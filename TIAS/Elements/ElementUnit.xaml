<UserControl x:Class="TIAS.Elements.ElementUnit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TIAS.Elements"
             mc:Ignorable="d" 
             MouseDown="Unit_Click">
    <Grid Height="45" Width="55" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image x:Name="UnitImage" Source="/Images/Unit/T34.png"/>
        <Grid x:Name="HealtBarMax" Width="40" VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                Height="3" Background="DarkRed" Margin="1">
            <Border x:Name="HealtBar" VerticalAlignment="Center" Width="39" HorizontalAlignment="Center" BorderThickness="1" BorderBrush="Red"/>
        </Grid>
    </Grid>
</UserControl>
