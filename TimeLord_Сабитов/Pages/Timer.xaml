<Page x:Class="TimeLord_Сабитов.Pages.Timer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TimeLord_Сабитов.Pages"
      mc:Ignorable="d" 
           d:DesignHeight="410" d:DesignWidth="782"
      Title="Timer">
    <Grid x:Name="timerBackground" Background="#FFE8E100">
        <TextBox x:Name="time" Text="00:01:00" HorizontalAlignment="Center" 
               VerticalAlignment="Center" Background="Transparent" BorderBrush="Transparent" Margin="299,95,299,242.6" Foreground="White"
               FontSize="48"/>
        <Button x:Name="start" Click="StartTimer" Content="Начать" HorizontalAlignment="Center" 
                VerticalAlignment="Center" Margin="0,312,0.4,72.6" Width="100" 
                Height="25" Background="White"/>
        <Button Content="Секундомер" Click="Stopwatch" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="10,10,0,0" Width="100" Height="25" Background="white"/>
    </Grid>
</Page>
