<Page x:Class="Сinema_Сабитов.Pages.RedactorCinema"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Сinema_Сабитов.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RedactorCinema">
    <Grid Background="white">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition />
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid Background="DarkBlue">
            <Button HorizontalAlignment="Right" Margin="10" Padding="15,0" Content="Перейти на постеры"/>
        </Grid>
        <Grid Background="LightBlue" Grid.Row="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchPanel" TextChanged="SearchPanel_TextChanged" VerticalAlignment="Center" Height="25" Margin="25" Width="400"/>
                    <StackPanel Orientation="Horizontal" Width="350">
                        <ComboBox x:Name="comboSelect" Width="200" VerticalAlignment="Center" Margin="25"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Количество"/>
                            <TextBox x:Name="Count" Width="75"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button Click="ClearFilter" Height="25" Width="150" Content="Отменить фильтры"/>
                    <Button Click="ApplyFilter" Height="25" Width="150" Content="Применить фильтры"/>
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <ScrollViewer>
                <StackPanel x:Name="parrent">
                    
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
